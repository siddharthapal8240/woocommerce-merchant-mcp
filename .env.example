WC_STORE_URL=https://your-test-store.example
WC_CONSUMER_KEY=replace_with_read_only_consumer_key
WC_CONSUMER_SECRET=replace_with_consumer_secret

# Optional process-local reliability limits (validated at startup).
WC_MAX_CONCURRENCY=4
WC_QUEUE_CAPACITY=16
WC_STARTS_PER_SECOND=5
WC_DEADLINE_MS=25000
WC_MAX_ATTEMPTS=3
WC_MAX_RESPONSE_BYTES=1048576
WC_SHUTDOWN_MS=5000
