{
  "tools": [
    {
      "name": "list_orders",
      "description": "List one page of orders, optionally filtered by status. Excludes customer contact data and addresses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": { "default": 1, "type": "integer", "minimum": 1, "maximum": 10000 },
          "per_page": { "default": 10, "type": "integer", "minimum": 1, "maximum": 50 },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "on-hold",
              "completed",
              "cancelled",
              "refunded",
              "failed"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    },
    {
      "name": "search_orders",
      "description": "Search orders using native WooCommerce text matching; not a guaranteed exact display-number lookup.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": { "default": 1, "type": "integer", "minimum": 1, "maximum": 10000 },
          "per_page": { "default": 10, "type": "integer", "minimum": 1, "maximum": 50 },
          "search": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["search"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    },
    {
      "name": "get_order",
      "description": "Get an order using its internal numeric ID from list/search results.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    },
    {
      "name": "list_products",
      "description": "List one page of products and stock. Null quantities are untracked; parent stock does not establish variation availability.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": { "default": 1, "type": "integer", "minimum": 1, "maximum": 10000 },
          "per_page": { "default": 10, "type": "integer", "minimum": 1, "maximum": 50 },
          "stock_status": { "type": "string", "enum": ["instock", "outofstock", "onbackorder"] }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    },
    {
      "name": "search_products",
      "description": "Search products by native text and/or SKU filter. At least one filter is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": { "default": 1, "type": "integer", "minimum": 1, "maximum": 10000 },
          "per_page": { "default": 10, "type": "integer", "minimum": 1, "maximum": 50 },
          "search": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sku": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    },
    {
      "name": "get_product",
      "description": "Get a product by internal ID, including inventory and variation IDs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    },
    {
      "name": "list_product_variations",
      "description": "List variations and inventory by parent product ID. Parent-managed stock requires checking the parent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
          "page": { "default": 1, "type": "integer", "minimum": 1, "maximum": 10000 },
          "per_page": { "default": 10, "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "required": ["product_id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    },
    {
      "name": "get_product_variation",
      "description": "Get exact variation inventory using its parent product_id and variation_id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
          "variation_id": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["product_id", "variation_id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": { "taskSupport": "forbidden" }
    }
  ]
}
