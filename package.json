{
  "name": "merchant-woocommerce-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only WooCommerce merchant connector for MCP agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
